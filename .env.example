# Generate fresh credentials with: python3 tools/init-env.py
# The bootstrap creates missing accounts; it never resets existing passwords.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
JUDGE_USERNAME=judge
JUDGE_PASSWORD=

# Defaults match the development host. Adjust these CPU IDs for your machine.
SERVICE_CPUSET=0-3,8-11
BENCHMARK_CPUSET=4-7,12-15

# Optional: absolute host path to this checkout's data/jobs directory.
# JOBS_HOST_DIR=/absolute/path/to/TTOJ/data/jobs
# TTNN_IMAGE=tt-oj-profiler-runtime:0.79.0
# METALIUM_IMAGE=tt-oj-metalium-profiler:0.79.0
# TTLANG_IMAGE=tt-oj-ttlang-runtime:1.1.10

# Chips the judge uses (one TT-Lang submission per chip, judged in parallel). The chips not
# listed stay free for interactive work on the machine; see docs/cs540-ttlang-deployment.md.
# TT_OJ_CHIPS=0,1,2

# Problem ids to hide from students (comma separated), applied at every site start.
# The CS540 instance hides the TTNN/Metalium demos that need the whole mesh.
# TT_OJ_HIDDEN_PROBLEMS=TT1001,TT1002,TT2001,TT2002
# Usernames left off /leaderboard besides staff accounts, e.g. test accounts (comma separated).
# TT_OJ_UNRANKED_USERS=student_demo
